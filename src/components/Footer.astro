---
import { Image } from 'astro:assets';
import logo from '../assets/Logo-white.svg';
import me from '../assets/home/me.jpg';
import { markdoc, telHref } from '../lib/content';
import type { read } from '../lib/content';

interface Props {
  settings: Awaited<ReturnType<typeof read<'settings'>>>;
}

const { settings } = Astro.props;
---

<footer class="dark-wrapper inverse-text">
  <div id="scroll-up">
    <button type="button" class="scroll-up" aria-label="Back to top">
      <span class="btn btn-square btn-full-rounded btn-icon">
        <i class="scroll-up-icon">
          <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" height="1em" width="1em" aria-hidden="true"
            ><path
              d="M240.971 130.524l194.343 194.343c9.373 9.373 9.373 24.569 0 33.941l-22.667 22.667c-9.357 9.357-24.522 9.375-33.901.04L224 227.495 69.255 381.516c-9.379 9.335-24.544 9.317-33.901-.04l-22.667-22.667c-9.373-9.373-9.373-24.569 0-33.941L207.03 130.525c9.372-9.373 24.568-9.373 33.941-.001z"
            ></path></svg
          >
        </i>
      </span>
    </button>
  </div>

  <div class="sub-footer">
    <div class="container-fluid inner text-center">
      <div class="row">
        <div class="col-md-3">
          <a href="/"><img src={logo.src} class="footer-logo" alt="Brian K Photography + Films" /></a>
          <div class="space25"></div>
          <a class="contact-button" href="/contact">Contact Us</a>
          <a class="contact-link" href={telHref(settings.phone)}>{settings.phone}</a>
          <br />
          <a class="contact-link" href={`mailto:${settings.email}`}>{settings.email}</a>
          <ul class="social social-bg social-s">
            <li>
              <a href={settings.facebook} target="_blank" rel="noopener" aria-label="Facebook">
                <i class="fa fa-facebook-f">
                  <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 320 512" height="1em" width="1em" aria-hidden="true"
                    ><path
                      d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"
                    ></path></svg
                  >
                </i>
              </a>
            </li>
            <li>
              <a href={settings.instagram} target="_blank" rel="noopener" aria-label="Instagram">
                <i class="fa fa-instagram">
                  <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" height="1em" width="1em" aria-hidden="true"
                    ><path
                      d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"
                    ></path></svg
                  >
                </i>
              </a>
            </li>
          </ul>
        </div>
        <div class="col-md-1 divider d-none d-sm-block">|</div>
        <div class="col-md-4 about-me">
          <Image src={me} class="my-image" width={300} alt="Brian K" />
          <div class="main-text">
            <h4>About Me:</h4>
            <Fragment set:html={markdoc(settings.aboutMe)} />
          </div>
        </div>
        <div class="col-md-1 divider d-none d-sm-block">|</div>
        <div class="col-md-3 zola-badge">
          <a target="_blank" rel="noopener" href={settings.zola}>
            <img height="200" width="200" alt="Featured on Zola" src="https://d1tntvpcrzvon2.cloudfront.net/static-assets/images/badges/featured_on_zola_v2.png" />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* react-scroll-up's inline styles: fixed bottom-right, fades in past 400px. */
  #scroll-up .scroll-up {
    position: fixed;
    bottom: 50px;
    right: 30px;
    z-index: 1;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s linear, visibility 0.2s;
  }
  #scroll-up .scroll-up.is-visible {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('#scroll-up .scroll-up');
  const sync = () => btn?.classList.toggle('is-visible', window.scrollY > 400);
  window.addEventListener('scroll', sync, { passive: true });
  sync();
  btn?.addEventListener('click', () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
