---
import Layout from '../layouts/Layout.astro';
import { markdoc, read } from '../lib/content';

const films = await read('films');
---

<Layout title="Wedding Videography">
  <div class="black-section sub-intro">
    <div class="header-text sub-header">Films</div>
  </div>
  <div class="container video-wrapper main-text main-info">
    <Fragment set:html={markdoc(films.intro)} />
    <br />
    {
      films.videos.map((v) => (
        <div class="plyr__video-embed" data-plyr>
          <iframe
            src={`https://player.vimeo.com/video/${v.vimeoId}?loop=false&byline=false&portrait=false&title=false&speed=true&transparent=0&gesture=media`}
            title={v.title}
            allowfullscreen
            allow="autoplay; fullscreen; picture-in-picture"
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
</Layout>

<script>
  import Plyr from 'plyr';
  import 'plyr/dist/plyr.css';

  document.querySelectorAll<HTMLElement>('[data-plyr]').forEach((el) => new Plyr(el));
</script>
