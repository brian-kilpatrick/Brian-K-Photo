---
import Layout from '../layouts/Layout.astro';
import { read } from '../lib/content';

const settings = await read('settings');

// HoneyBook renders the inquiry form into the placeholder div below.
const honeybookId = '5f9043aa43a3ba000d7acda2';
---

<Layout title="Contact Us" description={settings.contactDescription}>
  <div class="black-section sub-intro">
    <h1 class="header-text sub-header">Contact</h1>
  </div>
  <div class="container">
    <div class={`hb-p-${honeybookId}-1`}></div>
    <img height="1" width="1" style="display:none" alt="" src={`https://www.honeybook.com/p.png?pid=${honeybookId}`} />
  </div>
</Layout>

<script is:inline define:vars={{ honeybookId }}>
  (function (h, b, s, n, i, p, e, t) {
    h._HB_ = h._HB_ || {};
    h._HB_.pid = i;
    t = b.createElement(s);
    t.type = 'text/javascript';
    t.async = !0;
    t.src = n;
    e = b.getElementsByTagName(s)[0];
    e.parentNode.insertBefore(t, e);
  })(
    window,
    document,
    'script',
    'https://widget.honeybook.com/assets_users_production/websiteplacements/placement-controller.min.js',
    honeybookId,
  );
</script>
