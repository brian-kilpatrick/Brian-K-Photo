---
import Layout from '../layouts/Layout.astro';
import Slider from '../components/Slider.astro';
import MainLink from '../components/MainLink.astro';
import { asset, markdoc, read } from '../lib/content';

const home = await read('home');
const settings = await read('settings');

// Tells search engines who the business is and where it works.
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: settings.siteName,
  description: settings.siteDescription,
  url: 'https://www.briankphoto.com/',
  logo: 'https://www.briankphoto.com/img/LogoPng.png',
  image: 'https://www.briankphoto.com/img/site.jpg',
  email: settings.email,
  telephone: settings.phone,
  address: { '@type': 'PostalAddress', addressLocality: 'Philadelphia', addressRegion: 'PA', addressCountry: 'US' },
  areaServed: ['Philadelphia', 'New Jersey', 'Delaware', 'New York City'],
  sameAs: [settings.facebook, settings.instagram, settings.zola?.split('?')[0]].filter(Boolean),
};
---

<Layout structuredData={business}>
  <Slider slides={home.slides}>
    {home.taglineLines.map((line) => <>{line} <br /></>)}
    {home.taglineLead} <span class="special">{home.taglineFlourish}</span>
  </Slider>
  <div class="black-section header-text">
    <h1>{home.seoHeading}</h1>
  </div>
  <div class="container">
    <div class="main-info">
      <h2 class="your-engaged special">{home.introHeading}</h2>
      <div class="section-divider"></div>
      <div class="main-text">
        <Fragment set:html={markdoc(home.intro)} />
        <a class="contact-button" href="/contact">Contact Us</a>
      </div>
    </div>
  </div>

  <div class="gray-section">
    <div class="container">
      <div class="tiles">
        <MainLink caption="Photography" image={asset(home.photoTile)} href="/photo" />
        <MainLink caption="Films" image={asset(home.filmTile)} href="/video" />
      </div>
    </div>
  </div>

  {
    home.streamingVisible && (
      <div class="black-section">
        <div class="container">
          <div class="pricing main-text">
            <h2 class="investment">{home.streamingHeading}</h2>
            <div class="section-divider" />
            <Fragment set:html={markdoc(home.streaming)} />
          </div>
        </div>
      </div>
    )
  }
  <div class="container">
    <div class="pricing main-text">
      <h2 class="investment" id="investment">{home.investmentHeading}</h2>
      <div class="section-divider"></div>
      <Fragment set:html={markdoc(home.investment)} />
    </div>
  </div>
</Layout>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }
  @media (max-width: 767px) {
    .tiles {
      grid-template-columns: 1fr;
      gap: 25px;
      margin-bottom: 25px;
    }
  }
</style>
