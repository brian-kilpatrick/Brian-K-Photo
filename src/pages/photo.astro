---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import { read } from '../lib/content';

const { photos } = await read('photography');
---

<Layout title="Wedding Photography">
  <div class="black-section sub-intro">
    <div class="header-text sub-header">Photography</div>
  </div>
  <Gallery photos={photos} />
</Layout>
