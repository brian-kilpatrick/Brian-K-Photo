---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import { markdoc, read } from '../lib/content';

const { photos, intro, description } = await read('photography');
---

<Layout title="Wedding Photography" description={description}>
  <div class="black-section sub-intro">
    <h1 class="header-text sub-header">Photography</h1>
  </div>
  <div class="container main-text main-info">
    <Fragment set:html={markdoc(intro)} />
  </div>
  <Gallery photos={photos} />
</Layout>
