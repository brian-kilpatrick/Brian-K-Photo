---
import '../styles/style.scss';
import '../styles/index.scss';
import '../styles/footer.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { read } from '../lib/content';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const settings = await read('settings');
const siteTitle = settings.siteTitle;
const description = settings.siteDescription;
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const siteUrl = 'https://www.briankphoto.com';
const ogImage = `${siteUrl}/img/site.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />
    <link rel="icon" href="/img/LogoPng.png" type="image/png" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={siteTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteTitle} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="google-site-verification" content="RZlxZO_c4i2y8gUTWVruoa87dOwvA9pVi1QGFh19pdU" />
    <meta name="facebook-domain-verification" content="d67qmeh619xut86v3ekaenzzxxy9bp" />

    <!-- Google Analytics (carried over from the Gatsby site) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SKB575P3BE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-SKB575P3BE');
    </script>

    <!-- Facebook Pixel (carried over from the Gatsby site) -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1409621309434796');
      fbq('track', 'PageView');
    </script>
  </head>
  <body>
    <div class="content-wrapper">
      <Header />
      <slot />
      <Footer settings={settings} />
    </div>
  </body>
</html>
